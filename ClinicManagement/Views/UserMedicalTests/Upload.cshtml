@{
    ViewBag.Title = "Upload New Medical Test";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Upload New Medical Test</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@using (Html.BeginForm("Upload", "UserMedicalTests", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h4>Upload Medical Test File</h4>
        </div>
        <div class="card-body">
            <div class="form-group mb-3">
                <label for="medicalTestFile" class="form-label">Choose File</label>
                <input type="file" name="medicalTestFile" id="medicalTestFile" class="form-control" required />
            </div>

            <div class="form-group">
                <input type="submit" value="Upload" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<div class="mt-3">
    @Html.ActionLink("Back to List", "Index")
</div> 